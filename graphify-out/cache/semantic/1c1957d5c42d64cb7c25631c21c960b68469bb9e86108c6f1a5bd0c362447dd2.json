{"nodes": [{"id": "design_llm_usage_runtime_settings", "label": "LLM Token-Usage-Tracking & Runtime-Settings Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-23-llm-usage-and-runtime-settings-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_runtime_settings_override", "label": "DB-backed runtime settings override mechanism", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-23-llm-usage-and-runtime-settings-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settings stored in app_settings key/value table and applied via setattr onto the existing settings singleton at startup and on every admin edit. Rationale: backend runs single uvicorn worker (no --workers flag), so no multi-process cache invalidation needed; DB-backed overrides survive redeploys since Postgres persists independently of the container, unlike .env/GitHub variables which reset on each deploy."}, {"id": "concept_live_cost_calculation", "label": "Live cost calculation from editable price table", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-23-llm-usage-and-runtime-settings-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Costs are not frozen at call time but computed live from the current llm_model_price table (tokens / 1_000_000 * price) at display time, so historical cost figures reflect price corrections retroactively rather than being locked to pricing at time of call."}], "edges": [{"source": "design_llm_usage_runtime_settings", "target": "concept_runtime_settings_override", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-23-llm-usage-and-runtime-settings-design.md", "source_location": null, "weight": 1.0}, {"source": "design_llm_usage_runtime_settings", "target": "concept_live_cost_calculation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-23-llm-usage-and-runtime-settings-design.md", "source_location": null, "weight": 1.0}, {"source": "concept_runtime_settings_override", "target": "concept_call_llm_chokepoint", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "docs/superpowers/specs/2026-06-23-llm-usage-and-runtime-settings-design.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "runtime_settings_persistence_pattern", "label": "Redeploy-safe runtime settings persistence pattern", "nodes": ["concept_runtime_settings_override", "settings_appsetting", "pages_settingsadmin", "api_updateappsetting"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-06-23-llm-usage-and-runtime-settings-design.md"}]}